{
  "server": {
    "address": "127.0.0.1:9100",
    "allowed_origins": ["https://thermalik.laravel.cloud"]
  },
  "storage": {
    "job_store_path": "./data/jobs.json"
  },
  "printers": [
    {
      "id": "caja-principal",
      "name": "Caja principal",
      "transport": "network",
      "default": true,
      "capabilities": {
        "paper_width_mm": 58,
        "encodings": ["cp437", "cp850", "latin1"],
        "job_tracking": true
      },
      "network": {
        "address": "192.168.1.50:9100",
        "timeout": "5s"
      }
    },
    {
      "id": "caja-usb",
      "name": "Caja USB",
      "transport": "usb",
      "default": false,
      "capabilities": {
        "paper_width_mm": 58,
        "encodings": ["cp437", "cp850", "latin1"],
        "job_tracking": true
      },
      "usb": {
        "queue": "EPSON_TM_T20III",
        "vendor_id": "04b8",
        "product_id": "0e15"
      }
    }
  ]
}
